---
/**
 * The three rules the whole scheme rests on, shown rather than explained.
 *
 * Each card names its pairs by their Roman side and the Bangla is read out of
 * src/data/scheme.ts, so nothing here is a claim written by hand: it is the
 * same verified row the table below prints. An unknown key stops the build,
 * which is the only sane thing to do with a reference page.
 */
import { SCHEME_ROWS } from '../data/scheme';
import type { GuideRule } from '../copy/types';

interface Props {
  rules: GuideRule[];
}

const { rules } = Astro.props;

const cards = rules.map((rule) => ({
  heading: rule.heading,
  pairs: rule.keys.map((key) => {
    const row = SCHEME_ROWS.find((candidate) => candidate.roman === key);
    if (!row) throw new Error(`guide rules: no scheme row for ${JSON.stringify(key)}`);
    return row;
  }),
}));
---

<ul class="rules">
  {
    cards.map((card) => (
      <li class="rules__card">
        <p class="rules__heading" set:html={card.heading} />
        <dl class="rules__pairs">
          {card.pairs.map((row) => (
            <div class="rules__pair">
              <dt>
                <code>{row.roman}</code>
              </dt>
              <dd>
                <span lang="bn">{row.bangla}</span>
              </dd>
            </div>
          ))}
        </dl>
      </li>
    ))
  }
</ul>

<style>
  .rules {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .rules {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .rules__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-card);
    background: var(--color-veil);
  }

  .rules__heading {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .rules__heading :global(code) {
    font-size: 0.95em;
  }

  .rules__pairs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.75rem;
    margin: 0;
    margin-block-start: auto;
  }

  .rules__pair {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }

  .rules__pair dt,
  .rules__pair dd {
    margin: 0;
  }

  .rules__pair code {
    background: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-muted);
  }

  .rules__pair dd {
    font-family: var(--font-bangla);
    font-size: calc(var(--text-lg) * 1.06);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-brand);
  }
</style>
