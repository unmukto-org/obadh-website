---
/**
 * Every page opens the same way: a small coloured label, one large line, and
 * one paragraph. Centred, with a screen's worth of air under it, so that a
 * reference page and a landing page begin in the same voice.
 */
interface Props {
  eyebrow: string;
  heading: string;
  standfirst: string;
}

const { eyebrow, heading, standfirst } = Astro.props;
---

{/* No wash of its own: the one on <body> already tints the top of every
    page, and a second one stacked on it was the reason the site read as
    over-gradiented. */}
<header class="pt-12 pb-14 sm:pt-16 sm:pb-16 lg:pt-24 lg:pb-20">
  <div class="shell grid justify-items-center gap-5 text-center">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1
      class="max-w-[18ch] text-3xl leading-[1.06] font-semibold tracking-[-0.03em] text-balance"
      data-reveal
      style="--reveal-delay: 60ms"
      set:html={heading}
    />
    <p class="lede max-w-2xl" data-reveal style="--reveal-delay: 110ms" set:html={standfirst} />
  </div>
</header>
