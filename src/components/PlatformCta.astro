---
/**
 * The hero's download button, which reads the device in front of the reader.
 *
 *   iPhone, iPad  →  the App Store listing
 *   Mac           →  starts the disk image, then goes to /thanks/ with the steps
 *   anything else →  "Coming soon for Windows", and goes to /download/
 *
 * That is the difference between this and the button in the header, which
 * keeps the generic label and opens /download/, where every platform is listed
 * at once. This one is for someone who has already decided.
 *
 * It ships as the generic button and is specialised on the client, so a
 * crawler and a reader without JavaScript get something true for everyone: the
 * download page. The arrow only appears once the link points at a release, so
 * the button never promises a download it is not going to start.
 */
import { ui } from '../i18n/ui';
import { LINKS, localizedPath, type Locale } from '../config';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
const t = ui[locale];

const targets = {
  mac: LINKS.macDmg,
  iphone: LINKS.appStore,
  ipad: LINKS.appStore,
};

const soon = Object.fromEntries(
  Object.entries(t.platformNames).map(([key, name]) => [
    key,
    t.comingFor.replace('{platform}', name),
  ]),
);
---

<a
  class:list={['btn btn-primary', className]}
  href={localizedPath('/download/', locale)}
  data-platform-cta
  data-labels={JSON.stringify(t.getFor)}
  data-targets={JSON.stringify(targets)}
  data-soon={JSON.stringify(soon)}
  data-thanks={localizedPath('/thanks/', locale)}
  data-fallback={localizedPath('/download/', locale)}
>
  <svg
    class="cta-arrow"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3v12"></path>
    <path d="m7 11 5 5 5-5"></path>
    <path d="M4 20h16"></path>
  </svg>
  <span data-cta-label>{t.getObadh}</span>
</a>

<style>
  /* Hidden until the link is a release rather than a page. */
  .cta-arrow {
    display: none;
    flex: none;
    margin-inline-end: 0.1rem;
  }

  [data-platform-cta][data-direct] .cta-arrow {
    display: block;
  }

  /* A platform we have not reached. The button stays a real link to the list,
     so it is never a dead control, but it stops claiming to be a download. */
  [data-platform-cta][data-soon-state] {
    background: transparent;
    border-color: var(--color-hair-strong);
    color: var(--color-ink);
  }
</style>

<script>
  import { detectPlatform } from '../scripts/platform';

  const where = detectPlatform();

  for (const el of document.querySelectorAll<HTMLAnchorElement>('[data-platform-cta]')) {
    const labels = JSON.parse(el.dataset.labels ?? '{}') as Record<string, string>;
    const targets = JSON.parse(el.dataset.targets ?? '{}') as Record<string, string>;
    const soon = JSON.parse(el.dataset.soon ?? '{}') as Record<string, string>;
    const text = el.querySelector<HTMLElement>('[data-cta-label]');

    const label = labels[where];
    const target = targets[where];

    if (label && target) {
      if (text) text.textContent = label;
      el.href = target;
      el.dataset.direct = '';

      /*
        The Mac release is a file, and a file leaves the reader on the page
        they were already on with no idea what to do next. So the click goes
        to /thanks/?download, and that page starts the file. Starting it here
        and then leaving cancels it whenever GitHub's redirect is slower than
        the departure, which on a slow connection is always. A modified click
        (new tab, save link) keeps the plain file link.
      */
      if (where === 'mac') {
        const thanks = el.dataset.thanks;
        if (thanks) {
          el.addEventListener('click', (event) => {
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            event.preventDefault();
            window.location.href = `${thanks}?download`;
          });
        }
      }
      continue;
    }

    // Somewhere we cannot ship to. Name it, and keep the link honest.
    const waiting = soon[where] ?? soon.other;
    if (!waiting) continue;
    if (text) text.textContent = waiting;
    el.href = el.dataset.fallback ?? el.href;
    el.dataset.soonState = '';
  }
</script>
