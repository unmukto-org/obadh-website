---
/**
 * The reference rows for one group of the writing scheme.
 *
 * Every row is a pair: the keystrokes on the left, the Bangla they compose on
 * the right, and the note beside them where there is something to say. The
 * keystrokes are a button, because the one thing a person does with a row is
 * take the left-hand side away with them.
 *
 * A real <table>, because it is a table: two columns of paired values that a
 * screen reader should announce as pairs. On a narrow screen the rows lay
 * themselves out as blocks instead of scrolling sideways, which is why every
 * element carries its ARIA role explicitly — `display: grid` on a row would
 * otherwise take the table apart for anyone reading it rather than seeing it.
 */
import { SCHEME_ROWS, type SchemeGroup } from '../data/scheme';

interface Props {
  group: SchemeGroup;
  heads: { roman: string; bangla: string; note: string };
  /** Bangla notes, keyed by the row's roman value. Falls back to the English. */
  notes?: Record<string, string>;
  /** Names the copy button. The row's own keystrokes are appended to it. */
  copyLabel: string;
}

const { group, heads, notes, copyLabel } = Astro.props;
const rows = SCHEME_ROWS.filter((row) => row.group === group);
---

<div class="scheme" data-scheme>
  <table role="table">
    <thead role="rowgroup">
      <tr role="row">
        {
          /*
            A column header is re-announced on every cell, and there are 176
            rows. Chrome folds the uppercase transform into the accessible
            name, which made those three headers TYPE, YOU GET and NOTE —
            short capitals are exactly what a screen reader spells out letter
            by letter. The label is the header in its own case; the page is
            unchanged.
          */
        }
        <th role="columnheader" scope="col" aria-label={heads.roman}>{heads.roman}</th>
        <th role="columnheader" scope="col" aria-label={heads.bangla}>{heads.bangla}</th>
        <th role="columnheader" scope="col" class="scheme__note-head" aria-label={heads.note}>
          {heads.note}
        </th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        rows.map((row) => {
          const note = notes?.[row.roman] ?? row.note;
          return (
            <tr role="row" data-row>
              <td role="cell" class="scheme__roman">
                {/* Enabled by the page script, and only where there is a
                    clipboard to write to. A control that does nothing should
                    not be in the tab order of a 176-row page.

                    The two icons are one sprite, defined once in
                    GuidePage.astro: drawn inline they were 74 KB of the
                    page. */}
                <button
                  type="button"
                  class="scheme__copy"
                  data-copy={row.roman}
                  aria-label={`${copyLabel} ${row.roman}`}
                  disabled
                >
                  <code>{row.roman}</code>
                  <svg class="scheme__mark" aria-hidden="true">
                    <use class="scheme__mark-copy" href="#guide-copy" />
                    <use class="scheme__mark-done" href="#guide-copied" />
                  </svg>
                </button>
              </td>
              <td role="cell" class="scheme__bn" lang="bn">
                {row.bangla}
              </td>
              <td role="cell" class="scheme__note" set:html={note} />
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  /*
    A reference table and nothing more: what you type, what you get, and why
    where there is a why. The pair is the point, so the two value columns are
    set at reading size and the note stays out of their way.
  */
  .scheme {
    margin-block-start: 1.5rem;
    border-block-end: 1px solid var(--color-hair);
  }

  .scheme table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .scheme th:nth-child(1) {
    width: 24%;
  }

  .scheme th:nth-child(2) {
    width: 19%;
  }

  /*
    The header rides under the site header, so the two column labels are still
    there thirty-six rows into the consonants. It needs an opaque ground of its
    own, because the rows scroll under it — and its rule is drawn as a shadow,
    because a collapsed border belongs to the table and stays behind.
  */
  .scheme th {
    position: sticky;
    inset-block-start: var(--guide-sticky, 4.0625rem);
    z-index: 1;
    background: var(--color-ground);
    box-shadow: inset 0 -1px 0 var(--color-hair);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
    text-align: start;
    padding-block: 0.7rem 0.6rem;
    border: 0;
    white-space: nowrap;
  }

  /* Bengali has no case, so uppercasing it does nothing but widen the tracking
     of letters that were never meant to carry it. */
  :global(html[lang='bn']) .scheme th {
    font-family: var(--font-bangla);
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--text-xs);
  }

  .scheme td {
    padding-block: 0.45rem;
    border-block-start: 1px solid var(--color-hair);
    vertical-align: baseline;
  }

  .scheme tbody tr:first-child td {
    border-block-start: 0;
  }

  /* Three columns is two chances to lose the row you were reading. */
  .scheme tbody tr:hover td {
    background: var(--color-veil);
  }

  .scheme__roman {
    padding-inline-end: 1rem;
  }

  .scheme__bn {
    font-family: var(--font-bangla);
    /* Anek runs small for its point size beside Latin at the same measure, and
       a conjunct is the thing on this page a person came to look at. */
    font-size: calc(var(--text-lg) * 1.06);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
    padding-block: 0.16em 0.06em;
    color: var(--color-ink);
  }

  .scheme__note,
  .scheme__note-head {
    font-size: var(--text-xs);
    color: var(--color-faint);
    line-height: 1.55;
  }

  .scheme__note :global(a) {
    color: var(--color-brand);
  }

  /* --- the keystrokes, which are a button ------------------------------- */

  .scheme__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    margin-inline-start: -0.4rem;
    padding: 0.2rem 0.4rem;
    border: 0;
    border-radius: 7px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: background-color 120ms var(--ease-out);
  }

  .scheme__copy code {
    background: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-muted);
    overflow-wrap: anywhere;
    transition: color 120ms var(--ease-out);
  }

  .scheme__copy:disabled {
    cursor: default;
  }

  .scheme__copy:enabled:hover {
    background: var(--color-raise);
  }

  .scheme__copy:enabled:hover code {
    color: var(--color-ink);
  }

  .scheme__mark {
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--color-faint);
    opacity: 0;
    transition: opacity 120ms var(--ease-out);
  }

  .scheme__copy:enabled:hover .scheme__mark,
  .scheme__copy:focus-visible .scheme__mark {
    opacity: 1;
  }

  .scheme__mark-done {
    display: none;
  }

  /* Set by the page script for a second and a half after a successful copy.
     The announcement is a live region up in the toolbar; this is the half a
     sighted reader needs, on the row they actually pressed. */
  .scheme__copy[data-copied] .scheme__mark {
    opacity: 1;
    color: var(--color-brand);
  }

  .scheme__copy[data-copied] .scheme__mark-copy {
    display: none;
  }

  .scheme__copy[data-copied] .scheme__mark-done {
    display: inline;
  }

  /* Both, so the confirmation still shows on the row the pointer is resting on. */
  .scheme__copy[data-copied] code,
  .scheme__copy[data-copied]:hover code {
    color: var(--color-brand);
  }

  /* --- one column wide --------------------------------------------------- */
  /*
    Below this the three columns will not sit side by side without either
    breaking a Bangla conjunct or taking the page sideways. The row becomes a
    block instead: the pair on one line, the note under it. Every element keeps
    its role attribute, so the table is still a table to a screen reader.
  */
  @media (max-width: 45rem) {
    .scheme {
      border-block-start: 1px solid var(--color-hair);
    }

    .scheme thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .scheme tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'roman bangla' 'note note';
      align-items: baseline;
      column-gap: 1rem;
      padding-block: 0.6rem;
      border-block-start: 1px solid var(--color-hair);
    }

    .scheme tbody tr:first-child {
      border-block-start: 0;
    }

    .scheme td {
      display: block;
      width: auto;
      padding-block: 0;
      border: 0;
    }

    .scheme tbody tr:hover td {
      background: none;
    }

    .scheme__roman {
      grid-area: roman;
      padding-inline-end: 0;
    }

    .scheme__bn {
      grid-area: bangla;
      text-align: end;
    }

    .scheme__note {
      grid-area: note;
      margin-block-start: 0.2rem;
    }

    .scheme__note:empty {
      display: none;
    }
  }

  /* Every row is a control here, so it has to be one a thumb can hit. */
  @media (pointer: coarse) {
    .scheme__copy {
      min-height: 44px;
      padding-block: 0.6rem;
    }

    .scheme__mark {
      opacity: 1;
    }
  }
</style>
