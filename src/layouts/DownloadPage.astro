---
/**
 * /download/, the whole list, at a glance.
 *
 * No platform routing happens here. The hero button on the home page reads the
 * user agent and sends a person straight at their own release; someone who has
 * arrived on this page is choosing, or downloading for a device that is not in
 * their hand, or checking whether their platform is on the list yet. All three
 * want every platform visible at once with the button beside it.
 *
 * Five anchors are a contract other pages link into: ios, macos,
 * turning-it-on, other-platforms and build-from-source.
 */
import Base from './Base.astro';
import PageHead from '../components/PageHead.astro';
import type { DownloadContent } from '../copy/types';
import { LINKS, SITE, SITE_URL, absoluteUrl, localizedPath, type Locale } from '../config';

interface Props {
  locale: Locale;
  content: DownloadContent;
}

const { locale, content } = Astro.props;
const c = content;

const base = absoluteUrl(localizedPath('/download/', locale));
const author = { '@id': `${SITE_URL}/#unmukto` };

/* A downloadUrl only where the file exists. The Mac disk image is a real
   release; the App Store listing is a placeholder until the app is approved,
   and a fabricated download address is the one claim here a crawler would act
   on by itself. */
const app = (name: string, os: string, id: string, version: string, downloadUrl?: string) => ({
  '@type': 'SoftwareApplication',
  '@id': `${base}#${id}`,
  name,
  alternateName: 'অবাধ',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: os,
  softwareVersion: version,
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: ['bn', 'en'],
  author,
  ...(downloadUrl && { downloadUrl }),
});

const schema = [
  app('Obadh for iPhone and iPad', `iOS ${SITE.minOS.ios}, iPadOS ${SITE.minOS.ios}`, 'ios', SITE.versions.ios),
  app('Obadh for Mac', `macOS ${SITE.minOS.macos}`, 'macos', SITE.versions.macos, LINKS.macDmg),
];

const setup = [c.setup.ios, c.setup.macos];
---

<Base
  locale={locale}
  route="/download/"
  title={c.meta.title}
  description={c.meta.description}
  ogImage={c.meta.ogImage}
  ogImageAlt={c.meta.ogImageAlt}
  ogTitle={c.meta.ogTitle}
  ogDescription={c.meta.ogDescription}
  schema={schema}
>
  <PageHead eyebrow={c.eyebrow} heading={c.heading} standfirst={c.standfirst} />

  <div class="shell pb-24">
    <!-- ------------------------------------------------------- available -- -->
    <h2 class="visually-hidden">{c.releasesHeading}</h2>

    <ul class="grid gap-5 pt-10 md:grid-cols-2">
      {
        c.releases.map((release, index) => (<li
            class="card release grid content-start gap-5 p-7 sm:p-8"
            id={release.id}
            data-reveal
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <div class="grid gap-2">
              <h3 class="text-xl font-semibold tracking-tight">{release.name}</h3>
              <p class="text-sm text-muted">{release.requirement}</p>
            </div>

            <ul class="release__facts grid gap-1.5 text-sm text-muted">
              {release.facts.map((fact) => (<li>{fact}</li>))}
            </ul>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              <a
                class="btn btn-primary"
                href={release.action.href}
                data-thanks={release.id === 'macos' ? localizedPath('/thanks/', locale) : undefined}
              >
                {release.action.label}
              </a>
              {release.altAction && (<a class="link link--row text-sm" href={release.altAction.href}>
                  {release.altAction.label}
                </a>)}
            </div>

            {release.action.note && <p class="text-xs text-faint">{release.action.note}</p>}
          </li>))
      }
    </ul>

    <!-- ---------------------------------------------------- turning it on -- -->
    <section class="pt-20" id="turning-it-on">
      <div class="grid gap-3" data-reveal>
        <h2 class="text-2xl font-semibold tracking-tight">{c.setup.heading}</h2>
        <p class="max-w-2xl text-muted">{c.setup.lede}</p>
      </div>

      <div class="grid gap-5 pt-8 md:grid-cols-2">
        {
          setup.map((column, index) => (<div class="card grid content-start gap-4 p-7" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <h3 class="text-lg font-semibold tracking-tight">{column.heading}</h3>
              <ol class="steps grid gap-3 text-sm">
                {column.steps.map((step) => (<li>
                    {/* One wrapper, because the row is a grid: inline markup in
                        the step would otherwise become grid items of its own
                        and break the line apart. */}
                    <span set:html={step} />
                  </li>))}
              </ol>
            </div>))
        }
      </div>

      <p class="measure prose pt-8 text-sm" data-reveal set:html={c.setup.after} />
    </section>

    <!-- ------------------------------------------------- other platforms -- -->
    <section class="pt-20" id="other-platforms">
      <div class="grid gap-3" data-reveal>
        <h2 class="text-2xl font-semibold tracking-tight">{c.soon.heading}</h2>
        <p class="max-w-2xl text-muted">{c.soon.lede}</p>
      </div>

      <ul class="grid gap-3 pt-8 sm:grid-cols-2">
        {
          c.soon.rows.map((row, index) => (<li
              class="soon grid gap-1 rounded-card border border-hair p-5"
              data-reveal
              style={`--reveal-delay: ${index * 50}ms`}
            >
              <p class="flex items-baseline gap-3">
                <span class="font-semibold">{row.name}</span>
                <span class="soon__state text-xs">{row.stateLabel}</span>
              </p>
              <p class="text-sm text-muted">{row.line}</p>
            </li>))
        }
      </ul>

      <p class="pt-6" data-reveal>
        <a class="arrow" href={localizedPath(c.soon.action.href, locale)}>{c.soon.action.label}</a>
      </p>
    </section>

    <!-- ------------------------------------------------ build from source -- -->
    <section class="pt-20" id="build-from-source">
      <div class="grid gap-3" data-reveal>
        <h2 class="text-2xl font-semibold tracking-tight">{c.source.heading}</h2>
        <p class="max-w-2xl text-muted">{c.source.lede}</p>
      </div>

      <ul class="grid gap-3 pt-8">
        {
          c.source.repos.map((repo) => (<li class="repo grid gap-1 rounded-card border border-hair p-5 sm:grid-cols-[16rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
              <a class="link link--row font-mono text-sm" href={LINKS.github[repo.repo]}>
                {repo.name}
              </a>
              <p class="text-sm text-muted">{repo.body}</p>
            </li>))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  /* The same hand-off as the hero button: /thanks/ starts the file and shows
     the steps. Without this script the link is the file itself. */
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-thanks]')) {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      window.location.href = `${link.dataset.thanks}?download`;
    });
  }
</script>

<style>
  /* Each fact gets a tick, so the card reads as a spec rather than a paragraph
     broken into pieces. */
  .release__facts li {
    display: grid;
    grid-template-columns: 1.1em minmax(0, 1fr);
    align-items: baseline;
  }

  .release__facts li::before {
    content: '✓';
    color: var(--color-brand);
    font-size: 0.9em;
  }

  /* The only numbered list on the site, and it is numbered because the order
     is the instruction: iOS does not offer step three until step two is done. */
  .steps {
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 1.9em minmax(0, 1fr);
    align-items: baseline;
    counter-increment: step;
    color: var(--color-muted);
  }

  .steps li::before {
    content: counter(step);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-brand-ink);
  }

  /* A step can carry one link, and it has to look like one. */
  .steps a {
    color: var(--color-brand-ink);
    text-underline-offset: 0.2em;
  }

  .soon__state {
    color: var(--color-ember-ink);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
