---
/**
 * The 404 composes its own message through the thing the site is about, which
 * is the whole of it. No illustration, no search box, no second apology.
 *
 * One page, both languages: a static host serves one 404 document, so a
 * language switcher here could only point at a URL that does not exist.
 *
 * Note for whoever deploys this: the host must return HTTP 404 with this body.
 * Serving it with a 200 makes a soft 404 and search engines index it.
 */
import Base from '../layouts/Base.astro';
import { localizedPath } from '../config';

const links = [
  { route: '/download/', en: 'Get Obadh for iPhone, iPad and Mac', bn: 'আইফোন, আইপ্যাড ও ম্যাকে অবাধ নিন' },
  { route: '/guide/', en: 'How to type Bangla in Roman letters', bn: 'ইংরেজি বর্ণে বাংলা লেখার নিয়ম' },
  { route: '/faq/', en: 'Questions about typing Bangla with Obadh', bn: 'অবাধ দিয়ে বাংলা লেখা নিয়ে প্রশ্ন' },
  { route: '/', en: 'Obadh', bn: 'অবাধ' },
];
---

<Base
  locale="en"
  route="/404/"
  title="Page not found, Obadh"
  description="There is no page at this address. Everything on this site is one of seven pages."
  noindex
  noSwitch
>
  <div class="shell pt-16 pb-24 sm:pt-24">
    {/* The address, typed. Roman above, the Bangla it composes below, the
        same pair the whole site is built on, saying the thing itself. */}
    <div class="grid justify-items-center gap-3 text-center">
      <p class="font-mono text-sm text-faint">ei Thikanay kOnO pata nei</p>
      <p
        class="bg-gradient-to-r from-deep via-brand to-bright bg-clip-text py-[0.06em] font-bangla text-3xl leading-[1.4] font-medium text-transparent"
        lang="bn"
      >
        এই ঠিকানায় কোনো পাতা নেই
      </p>
    </div>

    <div class="mt-16 grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="prose">
        <h1 class="text-2xl font-semibold tracking-tight">There is no page at this address</h1>
        <p>
          The link may be old, or the address may have picked up a character on the way. Everything
          on this site is one of seven pages, and they are all in the header and the footer.
        </p>
        <ul class="list-none ps-0">
          {links.map((link) => <li><a href={localizedPath(link.route, 'en')}>{link.en}</a></li>)}
        </ul>
      </div>

      <div class="prose" lang="bn">
        <h2 class="py-[0.06em] text-2xl leading-[1.3] font-semibold">এই ঠিকানায় কোনো পাতা নেই</h2>
        <p>
          লিংকটি পুরোনো হতে পারে, কিংবা ঠিকানায় বাড়তি একটা অক্ষর ঢুকে গেছে। এই সাইটের সবটাই সাতটি
          পাতার মধ্যে, আর সাতটিই আছে উপরে আর নিচে, দুই জায়গাতেই।
        </p>
        <ul class="list-none ps-0">
          {links.map((link) => <li><a href={localizedPath(link.route, 'bn')}>{link.bn}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</Base>
